{
  "name": "lab05_SI",
  "version": "1.0.0",
  "description": "Laboratorio 5: Seguridad Informática - UNA Chat Seguro",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "mocha test/test.js",
    "test:unit": "mocha test/test.js",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "dependencies": {
    "@cronitorio/cronitor-rum": "^0.4.2",
    "@cronitorio/cronitor-rum-nextjs": "^0.5.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@sentry/node": "^11.10.0",
    "dotenv": "^18.0.9",
    "express": "*",
    "express-openid-connect": "^2.20.2",
    "socket.io": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "jest": "^29.7.0",
    "mocha": "^10.2.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
